<div class="page-header">
  <div>
    <span class="badge">Admin only</span>
    <h1>Models</h1>
    <p>Manage boat models and their configurations.</p>
  </div>
  <a class="btn" href="/admin/create_new_model">Add New Model</a>
</div>

<div class="card">
  <div id="modelMessage" class="message"></div>
  <div class="table-controls">
    <input id="searchModels" type="text" placeholder="Search models..." class="search-input">
  </div>
  <table class="data-table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Category</th>
        <th>Status</th>
        <th>Created</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody id="modelsTableBody">
      <tr><td colspan="5">Loading...</td></tr>
    </tbody>
  </table>
</div>

<script>
$(function () {
  let allModels = [];

  function showMessage(text, type = '') {
    $('#modelMessage').removeClass('error success').text(text).addClass(type);
  }

  function handleAuthError(xhr) {
    if (xhr.status === 401 || xhr.status === 403) window.location.href = '/login';
    else showMessage(xhr.responseJSON?.message || 'Request failed.', 'error');
  }

  function formatDate(dateString) {
    if (!dateString) return '-';
    const date = new Date(dateString);
    return date.toLocaleDateString();
  }

  function renderTable(models) {
    if (!models || models.length === 0) {
      $('#modelsTableBody').html('<tr><td colspan="5">No models found.</td></tr>');
      return;
    }

    $('#modelsTableBody').html(models.map(model => `
      <tr>
        <td><strong>${escapeHtml(model.title)}</strong><br><small>${escapeHtml(model.make)} ${escapeHtml(model.model)} - ${escapeHtml(model.year)}</small></td>
        <td><span class="badge">${escapeHtml(model.category)}</span></td>
        <td><span class="badge ${model.status === 'published' ? 'success' : 'warning'}">${escapeHtml(model.status)}</span></td>
        <td>${formatDate(model.createdAt)}</td>
        <td>
          <button class="small-btn edit-model" data-id="${escapeHtml(model._id)}">Edit</button>
          <button class="small-btn danger delete-model" data-id="${escapeHtml(model._id)}">Delete</button>
        </td>
      </tr>
    `).join(''));
  }

  function loadModels(search = '') {
    $.get('/api/admin/models', { search }).done(({ models }) => {
      allModels = models;
      renderTable(models);
    }).fail(handleAuthError);
  }

  function escapeHtml(value) {
    return $('<div>').text(value ?? '').html();
  }

  $('#searchModels').on('input', function () {
    const search = $(this).val().trim();
    const filtered = allModels.filter(model =>
      model.title.toLowerCase().includes(search.toLowerCase()) ||
      model.permalink.toLowerCase().includes(search.toLowerCase())
    );
    renderTable(filtered);
  });

  $(document).on('click', '.edit-model', function () {
    const id = $(this).data('id');
    window.location.href = `/admin/edit_model?id=${id}`;
  });

  $(document).on('click', '.delete-model', function () {
    const id = $(this).data('id');
    if (!confirm('Are you sure you want to delete this model?')) return;

    $.ajax({
      url: '/api/admin/models/' + id,
      method: 'DELETE'
    }).done(() => {
      showMessage('Model deleted successfully.', 'success');
      loadModels();
    }).fail(handleAuthError);
  });

  loadModels();
});
</script>
